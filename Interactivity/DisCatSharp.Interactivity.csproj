<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<PackageId>DisCatSharp.Interactivity</PackageId>
		<Description>
			DisCatSharp Interactivity Extension

			Unleash the full power of discord commands.

			Documentation: https://docs.dcs.aitsys.dev/articles/modules/interactivity.html
		</Description>
		<PackageTags>DisCatSharp,Discord API Wrapper,Discord,Bots,Discord Bots,AITSYS,Net8,Net9,Pagination,Reactions,Buttons,Interactive Commands,Interactivity,Message Components</PackageTags>
		<LangVersion>default</LangVersion>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ConcurrentHashSet" Version="1.3.0" />
		<PackageReference Include="Microsoft.DependencyValidation.Analyzers" Version="0.11.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
		<PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-alpha.338"/>
		<PackageReference Include="NetCord.Hosting" Version="1.0.0-alpha.338"/>
		<PackageReference Include="NetCord.Services" Version="1.0.0-alpha.338"/>
		<PackageReference Include="NetCord" Version="1.0.0-alpha.338"/>
	</ItemGroup>

</Project>
